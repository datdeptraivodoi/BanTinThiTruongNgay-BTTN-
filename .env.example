# Dịch tin: DeepSeek V4.1 Flash miễn phí qua OpenCode (https://opencode.ai) trước, rồi DeepSeek trả phí,
# rồi GLM miễn phí qua OpenCode, cuối cùng NVIDIA Riva. Kiểm tra khóa: python scripts/opencode_smoke.py
OPENCODE_API_KEY=
# DeepSeek translates articles; Python selects sentences and builds the report.
DEEPSEEK_API_KEY=
# Exact model id from GET https://api.deepseek.com/models (DeepSeek V4.1 Flash).
DEEPSEEK_MODEL=
# Dự phòng miễn phí: DeepSeek lỗi (hết số dư, sai khóa, mất mạng) thì NVIDIA Riva dịch; bản tin tuần cũng dùng.
NVIDIA_API_KEY=
# Source-data API is optional; DeepSeek key does not grant Trading Economics access.
TRADINGECONOMICS_API_KEY=
# Alternative: UTF-8 JSON article records imported from Trading Economics.
TE_NEWS_IMPORT_PATH=
SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENTS=datnh1@mbbank.com.vn,trungnt@mbbank.com.vn,research.treasury@mbbank.com.vn
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Only used by the dormant PDF conversion helper; not required for Word output.
LIBREOFFICE_PATH=
# Optional dated quotes copied from firm ALM Teams messages (never the example).
TRADER_QUOTES_PATH=
